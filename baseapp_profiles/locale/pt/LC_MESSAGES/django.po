#: apps.py
msgid "BaseApp Profiles"
msgstr "BaseApp Perfis"

#: graphql/mutations/invitations.py
msgid "Invalid invitation token"
msgstr "Token de convite inválido"

#: graphql/mutations/invitations.py
msgid "Invitation not found"
msgstr "Convite não encontrado"

#: graphql/mutations/invitations.py
msgid "This invitation has expired"
msgstr "Este convite expirou"

#: graphql/mutations/invitations.py
msgid "This invitation has already been responded to"
msgstr "Este convite já foi respondido"

#: graphql/mutations/invitations.py
msgid "This invitation was sent to a different user"
msgstr "Este convite foi enviado para outro usuário"

#: graphql/mutations/invitations.py
#, python-format
msgid "%(email)s is already a member of this profile"
msgstr "%(email)s já é membro deste perfil"

#: graphql/mutations/invitations.py
#, python-format
msgid "An invitation has already been sent to %(email)s"
msgstr "Um convite já foi enviado para %(email)s"

#: graphql/mutations/invitations.py
msgid "Cannot send invitation in current state"
msgstr "Não é possível enviar o convite no estado atual"

#: graphql/mutations/invitations.py graphql/mutations/profiles.py
#: graphql/mutations/roles.py
msgid "Profile not found"
msgstr "Perfil não encontrado"

#: graphql/mutations/invitations.py graphql/mutations/profiles.py
#: graphql/mutations/roles.py
msgid "You don't have permission to perform this action"
msgstr "Você não tem permissão para realizar esta ação"

#: graphql/mutations/invitations.py
msgid "At least one email is required"
msgstr "Pelo menos um e-mail é obrigatório"

#: graphql/mutations/invitations.py
msgid "The profile owner cannot accept an invitation to their own profile"
msgstr ""
"O proprietário do perfil não pode aceitar um convite para o próprio perfil"

#: graphql/mutations/invitations.py
msgid "Can only cancel pending invitations"
msgstr "Só é possível cancelar convites pendentes"

#: graphql/mutations/invitations.py
msgid "Can only resend expired or pending invitations"
msgstr "Só é possível reenviar convites expirados ou pendentes"

#: graphql/mutations/profiles.py
msgid "Username must be at least 8 characters long."
msgstr "O nome de usuário deve ter pelo menos 8 caracteres."

#: graphql/mutations/profiles.py
msgid "Username can only contain letters and numbers."
msgstr "O nome de usuário só pode conter letras e números."

#: graphql/mutations/profiles.py
#, python-format
msgid "Username already in use, suggested username: %(suggested_username)s"
msgstr "Nome de usuário já em uso, sugestão: %(suggested_username)s"

#: graphql/mutations/roles.py
msgid "Invalid role type"
msgstr "Tipo de função inválido"

#: graphql/mutations/roles.py
msgid "The profile owner cannot be added as a member"
msgstr "O proprietário do perfil não pode ser adicionado como membro"

#: graphql/mutations/roles.py
msgid "One or more of the selected users are already members of this profile"
msgstr "Um ou mais dos usuários selecionados já são membros deste perfil"

#: graphql/mutations/roles.py
msgid "Unable to add the selected members"
msgstr "Não foi possível adicionar os membros selecionados"

#: graphql/mutations/roles.py
msgid "Role is required"
msgstr "A função é obrigatória"

#: graphql/mutations/roles.py
msgid "Role not found"
msgstr "Função não encontrada"

#: graphql/mutations/roles.py
msgid "User role not found"
msgstr "Função do usuário não encontrada"


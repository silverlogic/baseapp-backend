"%(inviter)s convidou você para participar de <strong>%(profile)s</strong> "
"como <strong>%(role)s</strong>."

#: templates/profiles/emails/invitation-body.html.j2
msgid "Accept Invitation"
msgstr "Aceitar convite"

#: templates/profiles/emails/invitation-body.html.j2
#: templates/profiles/emails/invitation-body.txt.j2
#, python-format
msgid "This invitation will expire on %(expiration)s."
msgstr "Este convite expira em %(expiration)s."

#: templates/profiles/emails/invitation-body.html.j2
msgid "Didn't expect this invitation?<br />"
msgstr "Não esperava este convite?<br />"

#: templates/profiles/emails/invitation-body.html.j2
msgid "No worries, you can safely ignore this email."
msgstr "Sem problemas, você pode ignorar este e-mail com segurança."

#: templates/profiles/emails/invitation-body.txt.j2
#, python-format
msgid "Hi %(name)s,"
msgstr "Olá, %(name)s,"

#: templates/profiles/emails/invitation-body.txt.j2

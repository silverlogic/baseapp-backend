#: rest_framework/memberships/permissions.py
msgid "Choose a profile you belong to with the Current-Profile header."
msgstr ""
"Escolha um perfil do qual você faz parte com o cabeçalho Current-Profile."

#: rest_framework/memberships/serializers.py services/invitations.py
msgid "At least one email is required"
msgstr "Pelo menos um e-mail é obrigatório"

#: rest_framework/memberships/views.py services/invitations.py
msgid "Invalid invitation token"
msgstr "Token de convite inválido"

#: services/invitations.py
#, python-format
msgid "%(email)s is already a member of this profile"
msgstr "%(email)s já é membro deste perfil"

#: services/invitations.py
#, python-format
msgid "An invitation has already been sent to %(email)s"
msgstr "Um convite já foi enviado para %(email)s"

#: services/invitations.py
#, python-format
msgid "At most %(limit)d invitations can be sent at once"
msgstr "É possível enviar no máximo %(limit)d convites de uma vez"

#: services/invitations.py
msgid "This invitation was sent moments ago. Try again later."
msgstr "Este convite foi enviado há pouco. Tente novamente mais tarde."

#: services/invitations.py
msgid "Can only resend expired or pending invitations"
msgstr "Só é possível reenviar convites expirados ou pendentes"

#: services/invitations.py
msgid "Can only send pending invitations"
msgstr "Só é possível enviar convites pendentes"

#: services/invitations.py
msgid "Can only cancel pending invitations"
msgstr "Só é possível cancelar convites pendentes"

#: services/invitations.py
msgid "This invitation has expired"
msgstr "Este convite expirou"

#: services/invitations.py
msgid "This invitation has been cancelled"
msgstr "Este convite foi cancelado"

#: services/invitations.py
msgid "This invitation has already been responded to"
msgstr "Este convite já foi respondido"

#: services/invitations.py
msgid "This invitation was sent to a different user"
msgstr "Este convite foi enviado para outro usuário"

#: services/invitations.py
msgid "The profile owner cannot accept an invitation to their own profile"
msgstr ""
"O proprietário do perfil não pode aceitar um convite para o próprio perfil"

#: services/invitations.py
msgid "You are already a member of this profile"
msgstr "Você já é membro deste perfil"

#: services/invitations.py
msgid "Signing up from an invitation is not enabled"
msgstr "O cadastro a partir de um convite não está habilitado"

#: services/invitations.py
msgid "This invitation was not sent to an email address"
msgstr "Este convite não foi enviado para um endereço de e-mail"

#: services/invitations.py
msgid ""
"An account already exists for this email. Sign in to accept the invitation."
msgstr "Já existe uma conta para este e-mail. Entre para aceitar o convite."

#: services/invitations.py
msgid "This account has been deactivated. Contact an administrator."
msgstr "Esta conta foi desativada. Entre em contato com um administrador."

#: services/members.py
msgid "Invalid role type"
msgstr "Tipo de função inválido"

#: services/members.py
msgid "A profile must keep at least one active admin"
msgstr "Um perfil deve manter pelo menos um administrador ativo"

#: services/members.py
msgid "The profile owner cannot be added as a member"
msgstr "O proprietário do perfil não pode ser adicionado como membro"

#: services/members.py
msgid "One or more of the selected users are already members of this profile"
msgstr "Um ou mais dos usuários selecionados já são membros deste perfil"

#: services/members.py
msgid "Unable to add the selected members"
msgstr "Não foi possível adicionar os membros selecionados"

#: services/members.py
msgid "Only active members can be deactivated"
msgstr "Só membros ativos podem ser desativados"

#: services/members.py
msgid "Only deactivated members can be reactivated"
msgstr "Só membros desativados podem ser reativados"


#: rest_framework/memberships/permissions.py
msgid "Choose a profile you belong to with the Current-Profile header."
msgstr "Elige un perfil al que pertenezcas con el encabezado Current-Profile."

#: rest_framework/memberships/serializers.py services/invitations.py
msgid "At least one email is required"
msgstr "Se requiere al menos un correo electrónico"

#: rest_framework/memberships/views.py services/invitations.py
msgid "Invalid invitation token"
msgstr "Token de invitación inválido"

#: services/invitations.py
#, python-format
msgid "%(email)s is already a member of this profile"
msgstr "%(email)s ya es miembro de este perfil"

#: services/invitations.py
#, python-format
msgid "An invitation has already been sent to %(email)s"
msgstr "Ya se ha enviado una invitación a %(email)s"

#: services/invitations.py
#, python-format
msgid "At most %(limit)d invitations can be sent at once"
msgstr "Se pueden enviar como máximo %(limit)d invitaciones a la vez"

#: services/invitations.py
msgid "This invitation was sent moments ago. Try again later."
msgstr ""
"Esta invitación se envió hace un momento. Inténtalo de nuevo más tarde."

#: services/invitations.py
msgid "Can only resend expired or pending invitations"
msgstr "Solo se pueden reenviar invitaciones expiradas o pendientes"

#: services/invitations.py
msgid "Can only send pending invitations"
msgstr "Solo se pueden enviar invitaciones pendientes"

#: services/invitations.py
msgid "Can only cancel pending invitations"
msgstr "Solo se pueden cancelar invitaciones pendientes"

#: services/invitations.py
msgid "This invitation has expired"
msgstr "Esta invitación ha expirado"

#: services/invitations.py
msgid "This invitation has been cancelled"
msgstr "Esta invitación ha sido cancelada"

#: services/invitations.py
msgid "This invitation has already been responded to"
msgstr "Esta invitación ya ha sido respondida"

#: services/invitations.py
msgid "This invitation was sent to a different user"
msgstr "Esta invitación fue enviada a otro usuario"

#: services/invitations.py
msgid "The profile owner cannot accept an invitation to their own profile"
msgstr ""
"El propietario del perfil no puede aceptar una invitación a su propio perfil"

#: services/invitations.py
msgid "You are already a member of this profile"
msgstr "Ya eres miembro de este perfil"

#: services/invitations.py
msgid "Signing up from an invitation is not enabled"
msgstr "El registro desde una invitación no está habilitado"

#: services/invitations.py
msgid "This invitation was not sent to an email address"
msgstr "Esta invitación no se envió a una dirección de correo electrónico"

#: services/invitations.py
msgid ""
"An account already exists for this email. Sign in to accept the invitation."
msgstr ""
"Ya existe una cuenta con este correo electrónico. Inicia sesión para aceptar "
"la invitación."

#: services/invitations.py
msgid "This account has been deactivated. Contact an administrator."
msgstr "Esta cuenta ha sido desactivada. Contacta con un administrador."

#: services/members.py
msgid "Invalid role type"
msgstr "Tipo de rol inválido"

#: services/members.py
msgid "A profile must keep at least one active admin"
msgstr "Un perfil debe tener al menos un administrador activo"

#: services/members.py
msgid "The profile owner cannot be added as a member"
msgstr "El propietario del perfil no puede ser agregado como miembro"

#: services/members.py
msgid "One or more of the selected users are already members of this profile"
msgstr "Uno o más de los usuarios seleccionados ya son miembros de este perfil"

#: services/members.py
msgid "Unable to add the selected members"
msgstr "No se pudieron agregar los miembros seleccionados"

#: services/members.py
msgid "Only active members can be deactivated"
msgstr "Solo se pueden desactivar miembros activos"

#: services/members.py
msgid "Only deactivated members can be reactivated"
msgstr "Solo se pueden reactivar miembros desactivados"

#: templates/profiles/emails/invitation-body.html.j2
#, python-format
msgid "%(name)s, you've been invited!"
msgstr "¡%(name)s, has recibido una invitación!"

#: templates/profiles/emails/invitation-body.html.j2
msgid "You've been invited!"
msgstr "¡Te han invitado!"

#: templates/profiles/emails/invitation-body.html.j2
#, python-format
msgid ""
"%(inviter)s has invited you to join <strong>%(profile)s</strong> as a "
"<strong>%(role)s</strong>."
msgstr ""
"%(inviter)s te ha invitado a unirte a <strong>%(profile)s</strong> como "
"<strong>%(role)s</strong>."

#: templates/profiles/emails/invitation-body.html.j2
msgid "Accept Invitation"
msgstr "Aceptar invitación"

#: templates/profiles/emails/invitation-body.html.j2
#: templates/profiles/emails/invitation-body.txt.j2
#, python-format
msgid "This invitation will expire on %(expiration)s."
msgstr "Esta invitación expirará el %(expiration)s."

#: templates/profiles/emails/invitation-body.html.j2
msgid "Didn't expect this invitation?<br />"
msgstr "¿No esperabas esta invitación?<br />"

#: templates/profiles/emails/invitation-body.html.j2
msgid "No worries, you can safely ignore this email."
msgstr ""
"No te preocupes, puedes ignorar este correo electrónico de forma segura."

#: templates/profiles/emails/invitation-body.txt.j2
#, python-format
msgid "Hi %(name)s,"
msgstr "Hola, %(name)s:"

#: templates/profiles/emails/invitation-body.txt.j2
msgid "Hi there,"
msgstr "Hola,"

#: templates/profiles/emails/invitation-body.txt.j2
#, python-format
msgid "%(inviter)s has invited you to join %(profile)s as a %(role)s."
msgstr "%(inviter)s te ha invitado a unirte a %(profile)s como %(role)s."

#: templates/profiles/emails/invitation-body.txt.j2
msgid "Click the link below to accept:"
msgstr "Haz clic en el siguiente enlace para aceptar:"

#: templates/profiles/emails/invitation-body.txt.j2
msgid "If you didn't expect this invitation, you can safely ignore this email."
msgstr ""
"Si no esperabas esta invitación, puedes ignorar este correo electrónico de "
"forma segura."

#: templates/profiles/emails/invitation-subject.txt.j2
#, python-format
msgid "You've been invited to join %(profile)s"
msgstr "Te han invitado a unirte a %(profile)s"

#: apps.py
msgid "BaseApp Files"
msgstr "BaseApp Archivos"

#: graphql/mutations.py
msgid "At least one file must be provided"
msgstr "Se debe proporcionar al menos un archivo"

#: graphql/mutations.py
msgid "Target object not found"
msgstr "Objeto objetivo no encontrado"

#: graphql/mutations.py
msgid "This object does not support file attachments"
msgstr "Este objeto no admite archivos adjuntos"

#: graphql/mutations.py
msgid "Files are not enabled for this target"
msgstr "Los archivos no están habilitados para este objetivo"

#: graphql/mutations.py
msgid "You don't have permission to attach files to this object"
msgstr "No tienes permiso para adjuntar archivos a este objeto"

#: graphql/mutations.py
#, python-brace-format
msgid "File not found: {file_id}"
msgstr "Archivo no encontrado: {file_id}"

#: graphql/mutations.py
msgid "You don't have permission to attach this file"
msgstr "No tienes permiso para adjuntar este archivo"

#: graphql/mutations.py
#, python-brace-format
msgid "File {file_name} is already attached to another object"
msgstr "El archivo {file_name} ya está adjunto a otro objeto"

#: graphql/mutations.py graphql/utils.py
msgid "You don't have permission to perform this action"
msgstr "No tienes permiso para realizar esta acción"

#: graphql/utils.py
msgid "One or more files could not be found"
msgstr "No se encontraron uno o más archivos"

#: models.py
msgid "target"
msgstr "objetivo"

#: models.py
msgid "The document this file target belongs to"
msgstr "El documento al que pertenece este objetivo de archivos"

#: models.py
msgid "files count"
msgstr "cantidad de archivos"

#: models.py
msgid "Per-content-type file counts for the target"
msgstr "Cantidad de archivos por tipo de contenido para el objetivo"

#: models.py
msgid "is files enabled"
msgstr "archivos habilitados"

#: models.py
msgid "Whether files can be attached to the target"
msgstr "Indica si se pueden adjuntar archivos al objetivo"

#: models.py
msgid "file target"
msgstr "objetivo de archivos"

#: models.py
msgid "file targets"
msgstr "objetivos de archivos"

#: models.py
msgid "profile"
msgstr "perfil"

#: models.py
msgid "parent"
msgstr "padre"

#: models.py
msgid "The parent document this file belongs to"
msgstr "El documento padre al que pertenece este archivo"

#: models.py
msgid "content type"
msgstr "tipo de contenido"

#: models.py
msgid "MIME type of the uploaded file"
msgstr "Tipo MIME del archivo subido"

#: models.py
msgid "file name"
msgstr "nombre del archivo"

#: models.py
msgid "Original name of the uploaded file"
msgstr "Nombre original del archivo subido"

#: models.py
msgid "file size"
msgstr "tamaño del archivo"

#: models.py
msgid "File size in bytes"
msgstr "Tamaño del archivo en bytes"

#: models.py
msgid "file"
msgstr "archivo"

#: models.py
msgid "The stored file"
msgstr "El archivo almacenado"

#: models.py
msgid "name"
msgstr "nombre"

#: models.py
msgid "Display name for the file"
msgstr "Nombre para mostrar del archivo"

#: models.py
msgid "description"
msgstr "descripción"

#: models.py
msgid "Optional description of the file"
msgstr "Descripción opcional del archivo"

#: models.py
msgid "created by"
msgstr "creado por"

#: models.py
msgid "The user who uploaded the file"
msgstr "El usuario que subió el archivo"

#: models.py
msgid "Pending Upload"
msgstr "Subida pendiente"

#: models.py
msgid "Upload in Progress"
msgstr "Subida en progreso"

#: models.py
msgid "Upload Completed"
msgstr "Subida completada"

#: models.py
msgid "Upload Failed"
msgstr "Subida fallida"

#: models.py
msgid "Upload Aborted"
msgstr "Subida cancelada"

#: models.py
msgid "upload status"
msgstr "estado de la subida"

#: models.py
msgid "Status of the file upload"
msgstr "Estado de la subida del archivo"

#: models.py
msgid "upload ID"
msgstr "ID de subida"

#: models.py
msgid "S3 multipart upload ID for in-progress uploads"
msgstr "ID de subida multiparte de S3 para subidas en progreso"

#: models.py
msgid "total parts"
msgstr "total de partes"

#: models.py
msgid "Total number of parts for multipart upload"
msgstr "Número total de partes para la subida multiparte"

#: models.py
msgid "uploaded parts"
msgstr "partes subidas"

#: models.py
msgid "Tracking uploaded parts with ETags"
msgstr "Seguimiento de las partes subidas con ETags"

#: models.py
msgid "upload expires at"
msgstr "la subida expira el"

#: models.py
msgid "Expiration time for pending uploads"
msgstr "Fecha de expiración de las subidas pendientes"

#: models.py
msgid "Files are not enabled for this object."
msgstr "Los archivos no están habilitados para este objeto."

#: models.py
msgid "files"
msgstr "archivos"

#: rest_framework/files/download_views.py
msgid "This download link has expired."
msgstr "Este enlace de descarga ha expirado."

#: rest_framework/files/download_views.py
msgid "Invalid download link."
msgstr "Enlace de descarga no válido."

#: rest_framework/files/download_views.py rest_framework/files/views.py
#: rest_framework/uploads/presigned_views.py rest_framework/uploads/views.py
msgid "File not found"
msgstr "Archivo no encontrado"

#: rest_framework/uploads/presigned_views.py
#, python-format
msgid "Cannot upload parts in status: %(status)s"
msgstr "No se pueden subir partes en el estado: %(status)s"

#: rest_framework/uploads/presigned_views.py
msgid "The active storage backend does not support presigned part uploads"
msgstr ""
"El backend de almacenamiento activo no admite subidas de partes prefirmadas"

#: rest_framework/uploads/presigned_views.py
#, python-format
msgid "Invalid part number. Must be between 1 and %(total)s"
msgstr "Número de parte inválido. Debe estar entre 1 y %(total)s"

#: rest_framework/uploads/presigned_views.py
msgid "Invalid upload part request."
msgstr "Solicitud de subida de parte inválida."

#: rest_framework/uploads/presigned_views.py
msgid "Failed to upload part."
msgstr "Error al subir la parte."

#: rest_framework/uploads/serializers.py
#, python-format
msgid "Files of type %(extension)s are not allowed."
msgstr "No se permiten archivos de tipo %(extension)s."

#: rest_framework/uploads/serializers.py
msgid "This file type is not allowed."
msgstr "Este tipo de archivo no está permitido."

#: rest_framework/uploads/serializers.py
#, python-format
msgid "File is too large. The maximum size is %(max)s."
msgstr "El archivo es demasiado grande. El tamaño máximo es %(max)s."

#: rest_framework/uploads/serializers.py
msgid "Invalid parent_id: DocumentId not found"
msgstr "parent_id inválido: DocumentId no encontrado"

#: rest_framework/uploads/serializers.py
#, python-format
msgid "File size %(size)s doesn't match %(parts)s parts of %(part_size)s bytes"
msgstr ""
"El tamaño del archivo %(size)s no coincide con %(parts)s partes de "
"%(part_size)s bytes"

#: rest_framework/uploads/serializers.py
msgid "Each part must have 'part_number' and 'etag'"
msgstr "Cada parte debe tener 'part_number' y 'etag'"

#: rest_framework/uploads/serializers.py
msgid "part_number must be a positive integer"
msgstr "part_number debe ser un entero positivo"

#: rest_framework/uploads/serializers.py
msgid "etag must be a non-empty string"
msgstr "etag debe ser una cadena no vacía"

#: rest_framework/uploads/views.py
msgid "You don't have permission to upload files."
msgstr "No tienes permiso para subir archivos."

#: rest_framework/uploads/views.py
msgid "Invalid upload parameters."
msgstr "Parámetros de subida inválidos."

#: rest_framework/uploads/views.py
msgid "Failed to initiate upload."
msgstr "Error al iniciar la subida."

#: rest_framework/uploads/views.py
msgid "You don't have permission to complete this upload"
msgstr "No tienes permiso para completar esta subida"

#: rest_framework/uploads/views.py
msgid "Invalid or incomplete upload parts."
msgstr "Partes de subida inválidas o incompletas."

#: rest_framework/uploads/views.py
msgid "Failed to complete upload."
msgstr "Error al completar la subida."

#: rest_framework/uploads/views.py
msgid "You don't have permission to abort this upload"
msgstr "No tienes permiso para cancelar esta subida"

#: rest_framework/uploads/views.py
msgid "Only an upload that hasn't completed can be aborted."
msgstr "Solo se puede cancelar una subida que no se haya completado."

#: rest_framework/uploads/views.py
msgid "Failed to abort upload."
msgstr "Error al cancelar la subida."

#: rest_framework/utils.py
msgid "Invalid parent: target not found."
msgstr "Padre inválido: objetivo no encontrado."

#: rest_framework/utils.py
msgid "This object does not support file attachments."
msgstr "Este objeto no admite archivos adjuntos."

#: rest_framework/utils.py
msgid "You don't have permission to attach files to this object."
msgstr "No tienes permiso para adjuntar archivos a este objeto."

#: tokens.py
msgid "Missing token parameter"
msgstr "Falta el parámetro token"

#: tokens.py
msgid "Token has expired"
msgstr "El token ha expirado"

#: tokens.py
msgid "Invalid token signature"
msgstr "Firma del token inválida"

#: tokens.py
msgid "Invalid token for this file/part"
msgstr "Token inválido para este archivo/parte"

#: tokens.py
msgid "Token does not match the current upload session"
msgstr "El token no coincide con la sesión de subida actual"

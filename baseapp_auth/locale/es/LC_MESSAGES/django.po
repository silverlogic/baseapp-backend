msgid "The two password fields didn't match."
msgstr "Los dos campos de contraseña no coinciden."

#: forms.py
msgid "Password"
msgstr "Contraseña"

#: forms.py
msgid "Password confirmation"
msgstr "Confirmación de contraseña"

#: forms.py
msgid "Enter the same password as above, for verification."
msgstr "Ingrese la misma contraseña que arriba, para verificación."

#: forms.py
msgid ""
"Raw passwords are not stored, so there is no way to see this user's "
"password, but you can <a href='../password/'>change the password.</a>"
msgstr ""
"Las contraseñas en bruto no se almacenan, por lo que no hay forma de ver la "
"contraseña de este usuario, pero puede <a href='../password/'>cambiar la "
"contraseña.</a>"


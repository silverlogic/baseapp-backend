{% extends 'emails/base.html.j2' %}

{% block content %}
<p class="t-h5">{{ _("Hello,") }}</p>
<p class="t-body2 gap-top-3">{{ _("Your email address has been changed to %(new_email)s. Please click below to confirm your new email address:", new_email=new_email) }}</p>
<a href="{{ url }}" class="button t-button gap-top-3 margin-center">{{ _("Confirm Email Change") }}</a>
<p class="t-caption gap-top-3 text-center">{{ _("If you did not initiate this change, please contact our support team as soon as possible.") }}</p>
{% endblock %}

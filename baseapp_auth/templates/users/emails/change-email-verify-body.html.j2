{% extends 'emails/base.html.j2' %}

{% block content %}
<p class="t-h5">{{ _("Hello,") }}</p>
<p class="t-body2 gap-top-3">{{ _("We're just a step away from updating your email. Please confirm your new email address by clicking the button below:") }}</p>
<a href="{{ url }}" class="button t-button gap-top-3 margin-center">{{ _("Confirm Email Change") }}</a>
<p class="t-caption-captiontion gap-top-3 text-center">{{ _("If you did not request this change you can safely ignore this email.") }}</p>
{% endblock %}

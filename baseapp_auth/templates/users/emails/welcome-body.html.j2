{% extends 'emails/base.html.j2' %}

{% block content %}
<p class="t-h5">{{ _("Hello,") }}</p>
<p class="t-body2 gap-top-3">{{ _("Great to have you on board! Let's make sure your email is all set. Please confirm your email address by clicking the button below:") }}</p>
<a href="{{ confirm_url }}" class="button t-button gap-top-3 margin-center">{{ _("Confirm Email Address") }}</a>
<p class="t-caption gap-top-3 text-center">
    {{ _("Didn't sign up?<br />") }}
    {{ _("No worries, you can safely ignore this email.") }}
</p>
{% endblock %}
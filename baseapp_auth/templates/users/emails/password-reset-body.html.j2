{% extends 'emails/base.html.j2' %}

{% block content %}
<p class="t-h5">{{ _("Hello,") }}</p>
<p class="t-body2 gap-top-3">{{ _("We received a request to reset the password for your account. If you made this request, please reset your password clicking the button below:") }}</p>
<a href="{{ url }}" class="button t-button gap-top-3 margin-center">{{ _("Reset Password") }}</a>
<p class="t-caption gap-top-3 text-center">{{ _("If you did not request a password reset, please ignore this email.") }}</p>
{% endblock %}

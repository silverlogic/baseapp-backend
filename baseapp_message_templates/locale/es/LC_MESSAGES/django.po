#: admin.py
msgid ""
"MESSAGE_TEMPLATES_EDITOR is set to 'ckeditor' but django-ckeditor is not "
"installed."
msgstr ""
"MESSAGE_TEMPLATES_EDITOR está configurado como 'ckeditor' pero django-"
"ckeditor no está instalado."

#: apps.py
msgid "BaseApp Message Templates"
msgstr "BaseApp Plantillas de mensajes"

#: graphql/mutations.py
msgid "Email template not found."
msgstr "Plantilla de correo no encontrada."

#: graphql/mutations.py
msgid "You don't have permission to perform this action"
msgstr "No tienes permiso para realizar esta acción"

#: graphql/mutations.py
msgid "This part of the email cannot be edited."
msgstr "Esta parte del correo no se puede editar."

#: graphql/mutations.py
#, python-format
msgid "Use at most %(max)d characters."
msgstr "Usa como máximo %(max)d caracteres."

#: graphql/mutations.py
msgid "The address the test was sent to."
msgstr "La dirección a la que se envió la prueba."

#: graphql/mutations.py
msgid "Your account has no email address to send the test to."
msgstr "Tu cuenta no tiene una dirección de correo a la que enviar la prueba."

#: graphql/mutations.py
msgid "Too many test emails. Try again later."
msgstr "Demasiados correos de prueba. Inténtalo de nuevo más tarde."

#: graphql/mutations.py graphql/object_types.py
msgid "This email needs real data to preview."
msgstr "Este correo necesita datos reales para la vista previa."

#: graphql/object_types.py
msgid "Dotted name, e.g. order.number."
msgstr "Nombre con puntos, p. ej. order.number."

#: graphql/object_types.py
msgid "Value used by previews."
msgstr "Valor que usan las vistas previas."

#: graphql/object_types.py
msgid "Registered label, or the name."
msgstr "Etiqueta registrada, o el nombre."

#: graphql/object_types.py
msgid "Whether code registered this template."
msgstr "Si el código registró esta plantilla."

#: graphql/object_types.py
msgid ""
"Parts staff may override: subject, plainTextContent and/or htmlContent. "
"Empty for templates that are not registered."
msgstr ""
"Partes que el personal puede sobrescribir: subject, plainTextContent y/o "
"htmlContent. Vacío para las plantillas no registradas."

#: graphql/object_types.py
msgid "Raw source of the default subject file."
msgstr "Código fuente del archivo de asunto predeterminado."

#: graphql/object_types.py
msgid "Raw source of the default plain-text file."
msgstr "Código fuente del archivo de texto plano predeterminado."

#: graphql/object_types.py
msgid "Whether an editable part is overridden."
msgstr "Si alguna parte editable está sobrescrita."

#: graphql/object_types.py
msgid "The subject rendered with sample values; null when it cannot render."
msgstr ""
"El asunto renderizado con valores de ejemplo; null si no se puede renderizar."

#: graphql/object_types.py
msgid ""
"Render with sample values. Arguments preview unsaved text for editable "
"parts; omitted ones use the saved text, blank ones the default."
msgstr ""
"Renderiza con valores de ejemplo. Los argumentos previsualizan texto sin "
"guardar para las partes editables; los omitidos usan el texto guardado y los "
"vacíos, el predeterminado."

#: graphql/queries.py
msgid ""
"Email templates ordered by name. Empty without the view_emailtemplate "
"permission."
msgstr ""
"Plantillas de correo ordenadas por nombre. Vacío sin el permiso "
"view_emailtemplate."

#: models.py
msgid "Case insensitive character"
msgstr "Carácter insensible a mayúsculas y minúsculas"


msgstr "Texto que se insertará en la versión HTML de la plantilla"

#: models.py
msgid "plain text content"
msgstr "contenido en texto plano"

#: models.py
msgid "Text that will be inputted into Template plain text version"
msgstr "Texto que se insertará en la versión de texto plano de la plantilla"

#: models.py
msgid "email template"
msgstr "plantilla de correo electrónico"

#: models.py
msgid "email templates"
msgstr "plantillas de correo electrónico"

#: models.py
msgid "Can send test emails of an email template"
msgstr "Puede enviar correos de prueba de una plantilla de correo"

#: models.py
msgid "template"
msgstr "plantilla"

#: models.py
msgid "file"
msgstr "archivo"

#: models.py
msgid "filename"
msgstr "nombre del archivo"

#: models.py
msgid "attachment"
msgstr "adjunto"

#: models.py
msgid "attachments"
msgstr "adjuntos"

#: models.py
msgid "message"
msgstr "mensaje"

#: models.py
msgid "Message to be sent"
msgstr "Mensaje a enviar"

#: models.py
msgid "SMS template"
msgstr "plantilla de SMS"

#: models.py
msgid "SMS templates"
msgstr "plantillas de SMS"

#: registry.py
#, python-format
msgid "Template syntax error: %(error)s"
msgstr "Error de sintaxis en la plantilla: %(error)s"

#: registry.py
#, python-format
msgid "The “%(tag)s” tag is not allowed here."
msgstr "La etiqueta «%(tag)s» no está permitida aquí."

#: registry.py
#, python-format
msgid "Unknown placeholder “%(name)s”."
msgstr "Marcador desconocido «%(name)s»."

#: services.py
